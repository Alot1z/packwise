{
  "rewrites": [
    {
      "source": "/((?!assets/|manifest\\.webmanifest|logo\\.svg|favicon|og-image).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true
}
