# PackWise web app — required build-time env vars (Vite).
# Copy to .env and fill in; a preview/deploy that omits these builds a shell
# with NO backend (main.tsx only creates the Convex client when this is set),
# so /auth and /dashboard stay dead.

# Convex backend URL (e.g. https://<deployment>.convex.cloud or a dev URL).
# Required for auth + all data. Without it the app renders without Convex.
VITE_CONVEX_URL=

# vly.ai integrations (optional but used by the app at runtime).
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=
